                    <value>&lt;!DOCTYPE html&gt;
&lt;html lang="en"&gt;
   &lt;head&gt;
                                                                   
      &lt;style type="text/css"&gt;
		
	&lt;/style&gt;
	&lt;/head&gt;
   &lt;body&gt;
       &lt;P&gt;Hi Team, &lt;/P&gt;
	   &lt;p&gt;&lt;b&gt;${property.INTERFACE_NAME} &lt;/b&gt; -  Failed&lt;/p&gt;
	   &lt;table border="1" cellpadding="10" cellspacing="10"&gt;
			
			&lt;tr&gt;&lt;td&gt;&lt;b&gt;Total Records&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;${property.totalRecordCount}&lt;/td&gt;&lt;/tr&gt;
			
			&lt;tr&gt;&lt;td&gt;&lt;b&gt;Failed Records&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;${property.failedRecordCount}&lt;/td&gt;&lt;/tr&gt;
			
			&lt;tr&gt;&lt;td&gt;&lt;b&gt;Success Records&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;${property.successRecordCount}&lt;/td&gt;&lt;/tr&gt;
			
	&lt;/table&gt;
	   
	   &lt;br&gt;
	   &lt;br&gt;
  

Thanks,&lt;br&gt;
     &amp;nbsp;&amp;nbsp;HXM  Cloud Integration Team&lt;br&gt;&lt;br&gt;

&lt;i&gt;*This is a system-generated email. Please do not reply to this email address* &lt;/i&gt;	   
	   
   &lt;/body&gt;
