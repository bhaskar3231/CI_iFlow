ame="graduateYearSG" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Graduate Year"></Property><Property Name="healthTestDate" Type="Edm.DateTimeOffset" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="Medical &amp; Health Test Date"></Property><Property Name="highSchoolDateCA" Type="Edm.DateTimeOffset" Nullable="true" sap:required="true" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="Indicate the date of your high school graduation or when GED obtained"></Property><Property Name="hireRightConsentDate" Type="Edm.DateTimeOffset" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Consent Date"></Property><Property Name="hireRightOrderID" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="Order ID"></Property><Property Name="hireRightOrderStatus" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="Order Status"></Property><Property Name="hireRightPercent" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="BGC % Complete"></Property><Property Name="hireRightReport" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Background Check Report"></Property><Property Name="hiringCompany" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Hiring Company"></Property><Property Name="homeOfficeAllowance" Type="Edm.Decimal" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="Home Office Allowance"></Property><Property Name="homeOfficeAllowanceNonTax" Type="Edm.Decimal" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="Home Office Allowance (Non Taxable)"></Property><Property Name="homePhone" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Alternate Phone"></Property><Property Name="honorLvlSG" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Honor Level"></Property><Property Name="hourlySalaryUSCA" Type="Edm.Decimal" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="Hourly Salary"></Property><Property Name="housingAllowance" Type="Edm.Decimal" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Housing Allowance"></Property><Property Name="hukouLocation" Type="Edm.String" Nullable="true" sap:required="true" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Indicate your Hukou location? (City)"></Property><Property Name="id" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Application ID"></Property><Property Name="innerLondonAllowance" Type="Edm.Decimal" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="Inner London Allowance"></Property><Property Name="institutionSG" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Institution"></Property><Property Name="instrBankAR" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="It is important that you complete this process within 24 hours of your offer acceptance.Please indicate your bank selection, whether you prefer a new account or use an existing one of your own, for direct deposit of your salary (for employees) or internship allowance (for interns). Kindly follow the instructions in the attachments named “Beneficios e instrucciones (bank name)” received together with your offer letter in order to contact the bank and process your account request. NOTE: Delays in this process may affect your start date so please take action at your earliest convenience.      "></Property><Property Name="instrDisability" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Why are you being asked to complete this form?We are a federal contractor or subcontractor. The law requires us to provide equal employment opportunity to qualified people with disabilities. We have a goal of having at least 7% of our workers as people with disabilities. The law says we must measure our progress towards this goal. To do this, we must ask applicants and employees if they have a disability or have ever had one. People can become disabled, so we need to ask this question at least every five years. Completing this form is voluntary, and we hope that you will choose to do so. Your answer is confidential. No one who makes hiring decisions will see it. Your decision to complete the form and your answer will not harm you in any way. If you want to learn more about the law or this form, visit the U.S. Department of Labor’s Office of Federal Contract Compliance Programs (OFCCP) website at www.dol.gov/ofccp.How do I know if I have a disability?A disability is a condition that substantially limits one or more of your “major life activities.” If you have or have ever had such a condition, you are a person with a disability. Disabilities include, but are not limited to: Alcohol or other substance use disorder (not currently using drugs illegally)Autoimmune disorder, for example, lupus, fibromyalgia, rheumatoid arthritis, HIV/AIDSBlind or low vision Cancer (past or present)Cardiovascular or heart diseaseCeliac diseaseCerebral palsyDeaf or serious difficulty hearingDiabetes Disfigurement, for example, disfigurement caused by burns, wounds, accidents, or congenital disordersEpilepsy or other seizure disorderGastrointestinal disorders, for example, Crohn's Disease, irritable bowel syndromeIntellectual or developmental disabilityMental health conditions, for example, depression, bipolar disorder, anxiety disorder, schizophrenia, PTSDMissing limbs or partially missing limbsMobility impairment, benefiting from the use of a wheelchair, scooter, walker, leg brace(s) and/or other supports Nervous system condition, for example, migraine headaches, Parkinson&amp;rsquo;s disease, multiple sclerosis (MS)Neurodivergence, for example, attention-deficit/hyperactivity disorder (ADHD), autism spectrum disorder, dyslexia, dyspraxia, other learning disabilitiesPartial or complete paralysis (any cause)Pulmonary or respiratory conditions, for example, tuberculosis, asthma,emphysemaShort stature (dwarfism)Traumatic brain injury"></Property><Property Name="instrDisability2" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Reasonable Accommodation NoticeFederal law requires employers to provide reasonable accommodation to qualified individuals with disabilities. Please tell us if you require a reasonable accommodation to apply for a job or to perform your job. Examples of reasonable accommodation include making a change to the application process or work procedures, providing documents in an alternate format, using a sign language interpreter, or using specialized equipment.1Section 503 of the Rehabilitation Act of 1973, as amended. For more information about this form or the equal employment obligations of Federal contractors, visit the U.S. Department of Labor’s Office of Federal Contract Compliance Programs (OFCCP) website at www.dol.gov/ofccp. PUBLIC BURDEN STATEMENT: According to the Paperwork Reduction Act of 1995 no persons are required to respond to a collection of information unless such collection displays a valid OMB control number. This survey should take about 5 minutes to complete.    "></Property><Property Name="instrDisclaimer" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="I understand that my completion of an application for employment does not obligate Exxon Mobil, or any of its affiliates (collectively, the &quot;Company&quot;) to employ me or offer me a job and that I am not obligated to accept employment. During the application phase, any oral or written statements, do not constitute any contract of employment.By electronically signing this application, I certify that the information I provide in this application for employment is true and complete to the best of my knowledge and that this is a condition for employment and/or continued employment. I authorize the Company to investigate the accuracy and completeness of all statements contained in this application for employment.BY TYPING MY NAME BELOW, I CERTIFY THAT I UNDERSTAND AND AGREE TO THE ABOVE STATEMENT. I FURTHER CERTIFY THAT I HAVE READ THE COMPANY'S APPLICANT DATA USE STATEMENT AND AGREE TO ITS TERMS AND CONDITIONS. "></Property><Property Name="instrDisclaimerAO" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="I understand that by clicking “Submit” I certify that the information provided in this application is true, accurate and complete, without any omission of consequence.  I understand and agree that any misrepresentation, false statement, or omission of facts called for in this application will be sufficient cause to deny any offer with Esso Exploration Angola (Block 15) Limited or  terminate any future employment relationship eventually executed.  I understand that this application and/or any other related information does not constitute a job offer from the Company. "></Property><Property Name="instrDisclaimerAP" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Thank you for taking the time to complete our online application. To submit your application click the &quot;Apply&quot; button below.By clicking &quot;Apply&quot;, I hereby declare that the information provided herein is true and accurate. I understand that a misrepresentation or omission of facts called for herein will be sufficient cause for cancellation of consideration for employment or if applicable, termination of employment by the Company. I understand that this application and/or any other related information does not constitute a job offer from the Company. "></Property><Property Name="instrDisclaimerBENL" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Disclaimer - I declare that the information given was fully and truthfully completed. "></Property><Property Name="instrDisclaimerCA" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Thank you for taking the time to complete our online application. To submit your application click the &quot;Apply&quot; button below. By clicking &quot;Apply&quot;, you hereby declare that the information provided herein is true and accurate and understand that a misrepresentation or omission of facts called for herein may result in the Company not making an offer of employment, retracting a future offer of employment or terminating your employment for cause, without notice or pay in lieu of notice. "></Property><Property Name="instrDisclaimerCZHU" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="I understand that by clicking “Apply” I certify that the information provided in this application is true, accurate and complete, without any omission of consequence.  I understand that a misrepresentation or omission of facts called for in this application may be sufficient cause to deny or immediately terminate my employment.  I understand that this application and/or any other related information does not constitute a job offer from the Company. "></Property><Property Name="instrDisclaimerGB" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Thank you for taking the time to complete our online application. To submit your application click the &quot;Apply&quot; button below. "></Property><Property Name="instrDisclaimerGY" Type="Edm.String" Nullable="true" sap:required="true" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="I certify that the above information is true and complete to the best of my knowledge, without omission of any consequence.  I agree that any misrepresentation, false statement, or omission, made by me with respect to the information contained in the application or subsequent medical evaluation shall be sufficient cause to terminate any offer or my employment. I also authorize you to require reports from previous and current employers, schools, references, and law enforcement agencies. I further recognize that if I am offered employment, I will be required to undergo a post-offer medical evaluation and that my offer of employment will be conditioned upon the satisfactory result of that medical evaluation.  That medical evaluation will include testing for drug use, and I agree to such testing."></Property><Property Name="instrDisclaimerLA" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="By clicking &quot;Apply&quot;, I hereby declare that the information provided herein is true and accurate. I understand that a misrepresentation or omission of facts called for herein will be sufficient cause for cancellation of consideration for employment. I understand that this application and/or any other related information does not constitute a job offer from the Company. "></Property><Property Name="instrDisclaimerUS" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="I understand that by clicking &quot;Apply&quot; I certify that the information provided in this application is true, accurate and complete, without any omission of consequence.  I understand that a misrepresentation or omission of facts called for in this application will be sufficient cause to deny or immediately terminate my employment.  I understand that this application and/or any other related information does not constitute a job offer from the Company."></Property><Property Name="instrEEO" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="ExxonMobil is an Equal Opportunity Employer and does not discriminate on the basis of race, color, religion, gender, sexual orientation, gender identity, national origin, age, disability, veteran status or any other status protected by federal law.In order to comply with federal recordkeeping and reporting requirements and other legal obligations, which may apply, we invite you to voluntarily self-identify your race/ethnicity and gender.Submission of this information is voluntary, and refusal to provide it will not subject you to any adverse treatment.  Please be advised that the information provided here is confidential will only be used in accordance with the provisions of applicable laws, executive orders and regulations."></Property><Property Name="instrGovOfficial" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Depending on the circumstances, certain laws prohibit ExxonMobil from providing anything of value (including a job or training) to a Government Official (as defined below) or a close family member relative of a Government Official in order to secure an improper advantage.  A &amp;quot;Government Official&amp;quot; means any agent, officer, or employee (elected, appointed, or career) of (1) a government or any department or agency at the national, regional or local level; (2) a political party or candidate for political office; (3) a company that is majority-owned or controlled by a government such as a national oil company; or (4) a public international organization such as the World Bank, the United Nations or the International Monetary Fund.  In order to be sure that we comply with these laws, we gather information from each person seeking a position with the Company regarding any close relationship with a Government Official. In most cases simply being related to a Government Official does not disqualify an applicant from employment. The outcome with regard to each applicant will depend on a number of factors which the Company will carefully evaluate. Therefore, please respond completely and accurately to the following questions:"></Property><Property Name="instrIntro" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label=" Thank you for your interest in pursuing a new career opportunity with our organization.  We believe a career with us is highly stimulating and rewarding.  Finding and retaining diverse, talented employees is the key to our continued long-term success and is a practice that maintains our position as a global market leader.  Our people are focused and challenged and they take advantage of the substantial career and professional development programs we offer to foster a culture of continuous learning.     Our total remuneration package designed to support our long-term business objectives, as well as attract, retain and reward the most qualified employees. The company provides retirement benefits that support our long-term career orientation and business model.     We are an Equal Opportunity Employer.     "></Property><Property Name="instrNameUS" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Please enter your name exactly as it appears on your government issued photo identification document.     "></Property><Property Name="instrPostOffer" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="We were happy to receive your acceptance of our employment offer.  As part of our new hire process, we ask that you take a few minutes to read and respond, as appropriate, to the following statements and questions.We look forward to working with you, to the contributions you will make to the Company, and to opportunities for your professional growth.     "></Property><Property Name="instrPostOfferID" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Ensure that the provided identity number is the one from the hiring country. If it isn’t available yet, you should provide it to HR as soon as you join the company.   "></Property><Property Name="instrVeteran" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="ExxonMobil1 is a party to contracts with the U.S. Government and therefore is subject to Section 4212 of the Vietnam Era Veterans’ Readjustment Assistance Act of 1974, as amended (Section 4212), which requires Federal Government contractors to take affirmative action to employ and advance in employment: (1) disabled veterans; (2) recently separated veterans; (3) active duty wartime or campaign badge veterans; and (4) Armed Forces service medal veterans. Our affirmative action policy prohibits discrimination against protected veterans and requires the company to take affirmative action to employ and advance in employment qualified protected veterans at all levels of employment, including the executive level. The following invitation is made pursuant to this policy and the affirmative action obligations required by Section 4212. Disclosure of your status as a covered veteran is voluntary. Choosing not to provide this information will not subject you to any adverse treatment. The information will be used only in ways that are consistent with Section 4212. The information you submit will be kept confidential, except that (i) supervisors and managers may be informed regarding restrictions on the work duties of disabled veterans, and regarding necessary accommodations; (ii) first aid and safety personnel may be informed, when and to the extent appropriate, if you have a condition that might require emergency treatment; and (iii) government officials engaged in enforcing laws administered by the Office of Federal Contract Compliance Programs, or enforcing the Americans with Disabilities Act, may be informed.Please read the following definitions carefully and then indicate whether you believe any of the categories apply to you. NOTE: You do not have to indicate the specific category or categories that apply. DEFINITIONS OF PROTECTED VETERAN CATEGORIES:Active Duty Wartime or Campaign Badge Veteran (Previously ‘Other Protected Veteran’) A veteran who served in the U.S. military ground, naval or air service during a “period of war” as defined below or in a campaign or expedition for which a campaign badge has been authorized, under the laws administered by the Department of Defense. “Period of War” is defined for these purposes by the Department of Labor as:      June 27, 1950 – January 31, 1955 (Korean Conflict);      February 28, 1961 – May 7, 1975 (for veterans serving in the Republic of Vietnam);      August 5, 1964 – May 7, 1975 (for all other veterans who served during the Vietnam conflict);      August 2, 1990 – present (Gulf War). If you would like more information on campaigns or expeditions for which a campaign badge has been authorized, please visit: http://www.opm.gov/policy-data-oversight/veterans-services/vet-guide/. Armed Forces Service Medal Veteran A veteran who, while serving on active duty in the U.S. military, ground, naval or air service, participated in a United States military operation for which an Armed Forces service medal was awarded pursuant to Executive Order 12985. Disabled Veteran 1) A veteran of the U.S. military, ground, naval or air service who is entitled to compensation (or who but for the receipt of military retired pay would be entitled to compensation) under laws administered by the Secretary of Veterans Affairs, OR 2) A person who was discharged or released from active duty because of a service-connected disability. Recently Separated Veteran A veteran during the three-year period beginning on the date of such veteran’s discharge or release from active duty in the U.S. military, ground, naval or air service. 1References to “ExxonMobil”, “Corporation”, “Company”, “we”, “its”, and “our” are used for convenience and may refer to one or more of Exxon Mobil Corporation and its affiliates. Nothing contained herein is intended to override the corporate separateness of affiliated companies. Exxon Mobil Corporation has numerous affiliates, many with names that include ExxonMobil"></Property><Property Name="jobTitle" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="true" sap:label="Position Applied For"></Property><Property Name="lastName" Type="Edm.String" Nullable="true" sap:required="true" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="Last Name"></Property><Property Name="learningProgramFR" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Learning Program"></Property><Property Name="leatherheadAllowance" Type="Edm.Decimal" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="Leatherhead Allowance"></Property><Property Name="leaveAllowance" Type="Edm.Decimal" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Leave Allowance"></Property><Property Name="lettreCoeffFR" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Lettre Coefficient"></Property><Property Name="liaisonName" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="Day 1 Liaison Email"></Property><Property Name="litigationDetailSG" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="If yes, please provide details"></Property><Property Name="locationAllowance" Type="Edm.Decimal" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="Location Allowance"></Property><Property Name="lvlEmpIT" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Level of Employment"></Property><Property Name="maidenNameFR" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="If yes, what is your last name before marriage?"></Property><Property Name="maintenanceSupportAllow" Type="Edm.Decimal" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Maintenance Support Allowance"></Property><Property Name="marriageDate" Type="Edm.DateTimeOffset" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Date of marriage, if applicable"></Property><Property Name="mealAllowance" Type="Edm.Decimal" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="Lunch Allowance"></Property><Property Name="medicalAllowance" Type="Edm.Decimal" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable