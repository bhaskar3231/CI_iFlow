entInformationDetailV3NGA" sap:label="Payment Information Detail NGA" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:deletable="true"><Documentation><Summary>PaymentInformationDetailV3NGA</Summary><LongDescription>The PaymentInformationDetailV3NGA allows user to query, update, and delete country specific field for Nigeia. In this case it is called checkDigit.</LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - Payment Information</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="FOJobFunction" EntityType="SFOData.FOJobFunction" sap:label="Job Group" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:deletable="true"><Documentation><Summary>FOJobFunction</Summary><LongDescription>This is a foundation object that contains job information description.</LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - Foundation/Organization</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="Background_CareerComments" EntityType="SFOData.Background_CareerComments" sap:label="Background_CareerComments" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:deletable="true"><Documentation><Summary>Background*</Summary><LongDescription>Background objects are customizable to store general background information about an employee. Representative definitions include education and outside work experience</LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - Employee Profile</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="TimeManagementAlertMessage" EntityType="SFOData.TimeManagementAlertMessage" sap:label="Time Management Alert Message" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:deletable="false"><Documentation><Summary>TimeManagementAlertMessage</Summary><LongDescription>The fields in this part of the screen contain a unique key for the message, along with the variables that appear in it.</LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - Time Off</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="cust_workExperiences_child1" EntityType="SFOData.cust_workExperiences_child1" sap:label="workExperiences_child1" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:deletable="true"><Documentation><Summary></Summary><LongDescription></LongDescription><sap:tagcollection><sap:tag>Foundation/Platform (PLT)</sap:tag><sap:tag>PLT - Generic Objects</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="CandidateLight" EntityType="SFOData.CandidateLight" sap:label="CandidateLight" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:deletable="false"><Documentation><Summary>CandidateLight</Summary><LongDescription>The candidate light entity allows a user to query, insert and update the candidate profile. The candidate light entity contains core candidate profile data consisting of system, standard and custom fields. The metadata will show the standard and custom fields configured in the active template. If a field (standard or custom) is not configured in the template, then it will not show up in the metadata and not be a part of oData query. The system fields will always show up. Compared to the existing candidate entity it provides exactly the same functionality but the validation of mandatory fields is different; fewer mandatory fields are available.</LongDescription><sap:tagcollection><sap:tag>Recruiting (RCM)</sap:tag><sap:tag>RCM - Candidate</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="WorkScheduleDayModelSegment" EntityType="SFOData.WorkScheduleDayModelSegment" sap:label="Work Schedule Day Model Segment" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:deletable="true"><Documentation><Summary>Work Schedule Day Model Segment</Summary><LongDescription>A WorkScheduleDayModelSegment used within a WorkScheduleDayModel. Such a segment is used to define the working time as well as the unpaid breaks for a day.</LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - Time Off</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="EMMonitoredProcess" EntityType="SFOData.EMMonitoredProcess" sap:label="EMMonitoredProcess" sap:creatable="true" sap:updatable="false" sap:upsertable="true" sap:deletable="false"><Documentation><Summary></Summary><LongDescription></LongDescription><sap:tagcollection><sap:tag>Foundation/Platform (PLT)</sap:tag><sap:tag>PLT - Execution Manager</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="FormReviewFeedbackList" EntityType="SFOData.FormReviewFeedbackList" sap:label="FormReviewFeedbackList" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:deletable="false"><Documentation><Summary>FormReviewFeedbackList</Summary><LongDescription>It contains review feedback list for a form</LongDescription><sap:tagcollection><sap:tag>Performance and Goals (PM/GM)</sap:tag><sap:tag>PM/GM - Continuous Performance Management</sap:tag><sap:tag>PM - Forms Management</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="PerGlobalInfoDEU" EntityType="SFOData.PerGlobalInfoDEU" sap:label="Personal Information (Country Specific)" sap:creatable="false" sap:updatable="false" sap:upsertable="true" sap:deletable="false"><Documentation><Summary></Summary><LongDescription></LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="cust_nextassignment_child3_Final" EntityType="SFOData.cust_nextassignment_child3_Final" sap:label="nextassignment_child3_Final" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:deletable="true"><Documentation><Summary></Summary><LongDescription></LongDescription><sap:tagcollectio