 sap:sortable="true" sap:filterable="true" Relationship="SFOData.Background_InsideWorkExperience_User" FromRole="Background_InsideWorkExperience" ToRole="User" sap:label="userIdNav"></NavigationProperty></EntityType><EntityType Name="JobAppTemplate_Hiring_Candidate_Detail_Info_Form_V2"><Key><PropertyRef Name="templateId"></PropertyRef></Key><Property Name="ARWelfareFundInstr" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="The Company offers O.S.D.I.P.P. (Obra Social Personal de Dirección de la Industria Privada del Petróleo)’s health insurance plan. In case you choose another health insurance provider, kindly note that the enrollment should be requested and managed by you. If you are an Intern you must select “O.S.D.I.P.P.”     "></Property><Property Name="BGCComment" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Comments to Vendor"></Property><Property Name="BGCDateComplete" Type="Edm.DateTimeOffset" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="Background Check Date Completed"></Property><Property Name="BGCDateRequest" Type="Edm.DateTimeOffset" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="Background Check Date Requested"></Property><Property Name="BGCcompleteStatus" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="BGC Completion Status"></Property><Property Name="BelgiumInstruction" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="BELGIAN CITIZEN: The INSS (Identification number of the National Register) can be found at the back of your ID card. It consists of 11 digits, the first 6 numbers are your birth date = YY.MM.DD-xxx.xx (Please fill in digits only).FOREIGNER: The INSS (Identification number of the National Register) can be found at the front of your Belgian ID card. It consists of 11 digits, the first 6 numbers are your birth date = YY.MM.DD-xxx.xx (Please fill in digits only). If you don’t have an INSS number, please indicate as N/A."></Property><Property Name="CEBAORDate" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="CEB Confirm Date"></Property><Property Name="CEBOnsiteURL" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="CEB Onsite URL"></Property><Property Name="CREAIT" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="CREA"></Property><Property Name="CanadaInstruction" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="IMPORTANT: Canada candidates, please review the application and update the required values. For Identification Document Number field, please click on &quot;Click to Edit&quot; to update the default value."></Property><Property Name="FRInstruction" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Please fill in your Social Security Number (15 digits).     "></Property><Property Name="GPA" Type="Edm.String" Nullable="true" sap:required="true" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="GPA"></Property><Property Name="HCMPdeduction" Type="Edm.Decimal" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="HCMP Deduction (units)"></Property><Property Name="MOHComment" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="MOH Comments"></Property><Property Name="MOHContactName" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="MOH Contact Name"></Property><Property Name="ONB_NationalID_Type" Type="Edm.String" Nullable="true" sap:required="true" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="National ID Type for Mapping"></Property><Property Name="OrgUnitFRGR" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Organization Unit"></Property><Property Name="PNGInstruction" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Note: If you ar