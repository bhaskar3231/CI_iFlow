h date = YY.MM.DD-xxx.xx (Please fill in digits only). If you don’t have an INSS number, please indicate as N/A."></Property><Property Name="CEBAORDate" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="CEB Confirm Date"></Property><Property Name="CEBOnsiteURL" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="CEB Onsite URL"></Property><Property Name="CREAIT" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="CREA"></Property><Property Name="CanadaInstruction" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="IMPORTANT: Canada candidates, please review the application and update the required values. For Identification Document Number field, please click on &quot;Click to Edit&quot; to update the default value."></Property><Property Name="FRInstruction" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Please fill in your Social Security Number (15 digits).     "></Property><Property Name="GPA" Type="Edm.String" Nullable="true" sap:required="true" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="GPA"></Property><Property Name="HCMPdeduction" Type="Edm.Decimal" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sa