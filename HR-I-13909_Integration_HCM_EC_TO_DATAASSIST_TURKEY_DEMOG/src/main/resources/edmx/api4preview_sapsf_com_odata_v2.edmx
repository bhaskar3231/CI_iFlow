le="false" sap:upsertable="true" sap:deletable="false"><Documentation><Summary>EmpEmploymentHigherDuty</Summary><LongDescription>Contains Higher Duties information for an employee.</LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - HigherDuty/Temporary Assignment</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="cust_parameters" EntityType="SFOData.cust_parameters" sap:label="Parameters" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:deletable="true"><Documentation><Summary></Summary><LongDescription></LongDescription><sap:tagcollection><sap:tag>Foundation/Platform (PLT)</sap:tag><sap:tag>PLT - Generic Objects</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="EmploymentConditionContent" EntityType="SFOData.EmploymentConditionContent" sap:label="Employment Condition Content" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:deletable="true"><Documentation><Summary>NOT IN PRODUCT!</Summary><LongDescription></LongDescription><sap:tagcollection><sap:tag>Suite (STE)</sap:tag><sap:tag>STE - Skills Management</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="Candidate" EntityType="SFOData.Candidate" sap:label="Candidate" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:deletable="false"><Documentation><Summary>Candidate</Summary><LongDescription>The candidate entity allows a user to query, insert and update the candidate profile. The candidate entity contains core candidate profile data consisting of system, standard and custom fields. The metadata will show the standard and custom fields configured in the active template. If a field (standard or custom) is not configured in the template, then it will not show up in the metadata and not be a part of oData query. The system fields will always show up.</LongDescription><sap:tagcollection><sap:tag>Recruiting (RCM)</sap:tag><sap:tag>RCM - Candidate</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="JobApplicationOnboardingData" EntityType="SFOData.JobApplicationOnboardingData" sap:label="JobApplicationOnboardingData" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:deletable="false"><Documentation><Summary>JobApplicationOnboardingData</Summary><LongDescription>The JobApplicationOnboardingData represents the Onboarding portlet of a job application.</LongDescription><sap:tagcollection><sap:tag>Recruiting (RCM)</sap:tag><sap:tag>RCM - Job Application</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="FOJobClassLocalITA" EntityType="SFOData.FOJobClassLocalITA" sap:label="Job Role Italy" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:deletable="false"><Documentation><Summary>FOJobClassLocalITA</Summary><LongDescription>This is a foundation object that contains country-specific job class for ITA.</LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - Foundation/Organization</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="Background_StewardedPopulation" EntityType="SFOData.Background_StewardedPopulation" sap:label="Background_StewardedPopulation" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:deletable="true"><Documentation><Summary>Background*</Summary><LongDescription>Background objects are customizable to store general background information about an employee. Representative definitions include education and outside work experience</LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - Employee Profile</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="JobProfile" EntityType="SFOData.JobProfile" sap:label="Job Profile" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:deletable="true"><Documentation><Summary>JobProfile</Summary><LongDescription>Contains detailed profiling information of a job. It inherits all of the competency and skill information from a job role and describes additional job information, such as education, certification, and physical requirements.</LongDescription><sap:tagcollection><sap:tag>Suite (STE)</sap:tag><sap:tag>STE - Skills Management</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="JobApplicationStatusAuditTrail" EntityType="SFOData.JobApplicationStatusAuditTrail" sap:label="JobApplicationStatusAuditTrail" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:deletable="false"><Documentation><Summary>JobApplicationStatusAuditTrail</Summary><LongDescription>The JobApplication Audit trail represents the Audit trail information of a job application.</LongDescription><sap:tagcollection><sap:tag>Recruiting (RCM)</sap:tag><sap:tag>RCM - Job Application</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="cust_ONB2_China_FormsAcknowledgement" EntityType="SFOData.cust_ONB2_China_FormsAcknowledgement" sap:label="cust_ONB2_China_FormsAcknowledgement" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:deletable="true"><Documentation><Summary></Summary><LongDescription></LongDescription><sap:tagcollection><sap:tag>Foundation/Platform (PLT)</sap:tag><sap:tag>PLT - Generic Objects</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="FOCostCenter" EntityType="SFOData.FOCostCenter" sap:label="Cost Center" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:deletable="true"><Documentation><Summary>FOCostCenter</Summary><LongDescription>This is a foundation object that describes a cost center.</LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - Foundation/Organization</sap:tag><sap:tag>Recommended</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="cust_RCM_MAPPING_JOBCOUNTRY" EntityType="SFOData.cust_RCM_MAPPING_JOBCOUNTRY" sap:label="cust_RCM_MAPPING_JOBCOUNTRY" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:deletable="true"><Documentation><Summary></Summary><LongDescription></LongDescription><sap:tagcollection><sap:tag>Foundation/Platform (PLT)</sap:tag><sap:tag>PLT - Generic Objects</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="PicklistOption" EntityType="SFOData.PicklistOption" sap:label="PicklistOption" sap:creatable="true" sap:updatable="true" sap:upsertable="false" sap:deletable="false"><Documentation><Summary>PicklistOption</Summary><LongDescription>Contains information related to pick list options.</LongDescription><sap:tagcollection><sap:tag>Foundation/Platform (PLT)</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="LocalizedData" EntityType="SFOData.LocalizedData" sap:label="LocalizedData" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:deletable="false"><Documentation><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - Foundation/Organization</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="PerPerson" EntityType="SFOData.PerPerson" sap:label="Biographical Information" sap:creatable="false" sap:updatable="false" sap:upsertable="true" sap:deletable="false"><Documentation><Summary>PerPerson</Summary><LongDescription>This entity contains the non-effective-dated biographical information such as date of birth, country of birth. It is commonly used as the main entity when doing employee master extracts.</LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - Personal Information</sap:tag><sap:tag>Recommended</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="Background_Indicators" EntityType="SFOData.Background_Indicators" sap:label="Background_Indicators" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:deletable="true"><Documentation><Summary>Background*</Summary><LongDescription>Background objects are customizable to store general background information about an employee. Representative definitions include education and outside work experience</LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - Employee Profile</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="EmployeeProfilePageConfig" EntityType="SFOData.EmployeeProfilePageConfig" sap:label="EmployeeProfilePageConfig" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:deletable="false"><Documentation><Summary>EmployeeProfilePageConfig</Summary><LongDescription>EmployeeProfilePageConfig</LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - Employee Profile</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="TemporaryTimeInformation" EntityType="SFOData.TemporaryTimeInformation" sap:label="Temporary Time Information" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:deletable="true"><Documentation><Summary>Temporary Time Information</Summary><LongDescription>This object defines deviating time information for a specific period for a specific user. It is used, for example, if an employee is on vacation and someone else needs to take over his or her work schedule for the vacation period.</LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - Time Off</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="DGFilter" EntityType="SFOData.DGFilter" sap:label="Dynamic Group Filter" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:deletable="false"><Documentation><Summary>DGFilter</Summary><LongDescription>This entity represents filters for a given people pool.</LongDescription><sap:tagcollection><sap:tag>Foundation/Platform (PLT)</sap:tag><sap:tag>PLT - Role Based Permissions</sap:tag><sap:tag>Results List Not Supported</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySe