dm.String" Nullable="true" sap:required="false" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="content"></Property><Property Name="id" Type="Edm.Int64" Nullable="false" sap:required="false" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="id"></Property><Property Name="lastModified" Type="Edm.DateTime" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:display-format="Date" sap:label="lastModified"></Property><Property Name="objId" Type="Edm.Int64" Nullable="true" sap:required="false" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="objId"></Property></EntityType><EntityType Name="JobAppTemplate_Hiring_Applicant_Info_Form"><Key><PropertyRef Name="templateId"></PropertyRef></Key><Property Name="ARWelfareFundInstr" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="The Company offers O.S.D.I.P.P. (Obra Social Personal de Dirección de la Industria Privada del Petróleo)’s health insurance plan. In case you choose another health insurance provider, kindly note that the enrollment should be requested and managed by you. If you are an Intern you must select “O.S.D.I.P.P.”     "></Property><Property Name="BGCComment" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Comments to Vendor"></Property><Property Name="BGCDateComplete" Type="Edm.DateTimeOffset" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="Background Check Date Completed"></Property><Property Name="BGCDateRequest" Type="Edm.DateTimeOffset" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="Background Check Date Requested"></Property><Property Name="BGCcompleteStatus" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="BGC Completion Status"></Property><Property Name="BelgiumInstruction" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="BELGIAN CITIZEN: The INSS (Identification number of the National Register) can be found at the back of your ID card. It consists of 11 digits, the first 6 numbers are your birth date = YY.MM.DD-xxx.xx (Please fill in digits only).FOREIGNER: The INSS (Identification number of the National Register) can be found at the front of your Belgian ID card. It consists of 11 digits, the first 6 numbers are your birth date = YY.MM.DD-xxx.xx (Please fill in digits only). If you don’t have an INSS number, please indicate as N/A."></Property><Property Name="CEBAORDate" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="CEB Confirm Date"></Property><Property Name="CEBOnsiteURL" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="CEB Onsite URL"></Property><Property Name="CREAIT" Type