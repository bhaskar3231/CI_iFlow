S.D.I.P.P.”     "></Property><Property Name="AnnualSalary" Type="Edm.Decimal" Nullable="true" sap:required="false" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:field-control="jobAppPermissionsNav/AnnualSalary" sap:label="Annual Salary"></Property><Property Name="BGCComment" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:field-control="jobAppPermissionsNav/BGCComment" sap:label="Comments to Vendor"></Property><Property Name="BGCDateComplete" Type="Edm.DateTimeOffset" Nullable="true" sap:required="false" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:field-control="jobAppPermissionsNav/BGCDateComplete" sap:label="Background Check Date Completed"></Property><Property Name="BGCDateRequest" Type="Edm.DateTimeOffset" Nullable="true" sap:required="false" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:field-control="jobAppPermissionsNav/BGCDateRequest" sap:label="Background Check Date Requested"></Property><Property Name="BGCcompleteStatus" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:field-control="jobAppPermissionsNav/BGCcompleteStatus" sap:label="BGC Completion Status"></Property><Property Name="BelgiumInstruction" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:field-control="jobAppPermissionsNav/BelgiumInstruction" sap:label="BELGIAN CITIZEN: The INSS (Identification number of the National Register) can be found at the back of your ID card. It consists of 11 digits, the first 6 numbers are your birth date = YY.MM.DD-xxx.xx (Please fill in digits only).FOREIGNER: The INSS (Identification number of the National Register) can be found at the front of your Belgian ID card. It consists of 11 digits, the first 6 numbers are your birth date = YY.MM.DD-xxx.xx (Please fill in digits only). If you don’t have an INSS number, please indicate as N/A."></Property><Property Name="CEBAORDate" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:field-control="jobAppPermissionsNav/CEBAORDate" sap:label="CEB Confirm Date"></Property><Property Name="CEBOnsiteURL" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:field-control="jobAppPermissionsNav/CEBOnsiteURL" sap:label="CEB Onsite URL"></Property><Property Name="CREAIT" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:field-control="jobAppPermissionsNav/CREAIT" sap:label="CREA"></Property><Property Name="CanadaInstruction" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:field-control="jobAppPermissionsNav/CanadaInstruction" sap:label="IMPORTANT: Canada candidates, please review the application and update the required values. For Identification Document Number field, please click on &quot;Click to Edit&quot; to update the default value."></Property><Property Name="FRInstruction" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:visible="tr