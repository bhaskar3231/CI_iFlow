:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="External Job Posting Footer"></Property><Property Name="extJobDescHeader" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="External Job Posting Header"></Property><Property Name="extListingLayout" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="External Job Posting"></Property><Property Name="extTitle" Type="Edm.String" Nullable="true" sap:required="true" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="External Job Posting Title"></Property><Property Name="externalPrivatePosting" Type="Edm.Boolean" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Private External Posting URL"></Property><Property Name="formDueDate" Type="Edm.DateTimeOffset" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Req Completion Due Date"></Property><Property Name="id" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Job ID"></Property><Property Name="instrQuestions" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="  QUESTION INSTRUCTIONS - used for candidate application pre-screening    You can add additional questions to the application by either selecting them from the question library or creating your own question. Be sure that the question is legally acceptable in your country.    You can select from the following actions:    Required:  If this box is checked, candidates must answer the question before they are allowed to submit a job application.    Disqualifier:  If this box is checked and the candidate answers the question incorrectly, the candidate will be auto disqualified from the job requisition.  They will appear on the candidate list but they will be highlighted in pink.  An auto-disqualification communication will be sent to the candidate.      Score: 






 If you want to rank your candidates based on how they answer the question, check this box.  The question(s) with this box checked will be used to determine the candidate’s overall score, which can be used to sort the candidates on the candidate listing page.  Note: this must be used in conjunction with the &quot;weight&quot; box.    Weight:  Weight is used to specify the relative importance of each question. This is used when the &quot;score&quot; field is checked. If multiple fields are selected to be scored, you can signify that certain questions are more important than others by allocating a percentage between all the questions you would like to score.  For example, if one question is rated 10 and another 90, the second question valued as nine times more important.      Note that the total weight for all questions must add up to 100%    Required Score: Required score is used to establish a combined minimum threshold once you have scored and weighted each question. Be very careful setting this too high if you have also selected the questions as ‘Disqualifiers’. Anyone receiving a score below the ‘required score’ will automatically be disqualified and sent the auto disqualify communication. Leave the required score as zero if no screening questions are being scored.






    Actions: The Actions dropdown menu allows for editing or deleting of screening questions.    IMPORTANT NOTE: You will be unable to change the question section once a requisition has been opened and approved."></Property><Property Name="intJobDescFooter" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Internal Job Posting Footer"></Property><Property Name="intJobDescHeader" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Internal Job Posting Header"></Property><Property Name="jobPostLanguage" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Post Job in Language(s)"></Property><Property Name="jobRole" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Job Role"></Property><Property Name="listingLayout" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Internal Job Posting"></Property><Property Name="numberOpenings" Type="Edm.Decimal" Nullable="true" sap:required="true" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Revised Hiring Target"></Property><Property Name="questions" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Screening Questions"></Property><Property Name="recruiterEmail" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Recruiter's Email Address"></Property><Property Name="recruiterFax" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Recruiter's Fax Number"></Property><Property Name="recruiterPhone" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Recruiter's Phone Number"></Property><Property Name="secondRecruiterEmail" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Screener's Email Address"></Property><Property Name="secondRecruiterFax" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Screener's Fax Number"></Property><Property Name="secondRecruiterPhone" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Screener's Phone Number"></Property><Property Name="sectBudgetDetails" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="  JUSTIFICATION / BUDGET DETAIL --- This Section to be Completed by the Recruiting Advisor"></Property><Property Name="sectHMDetails" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="  JOB INFORMATION --- This Section to be Completed by the Recruiting Advisor"></Property><Property Name="sectJobApprovalInfo" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="  JOB APPROVAL INFORMATION  Please click on Add Approver on the Route Map section to select the hiring function approver to open this Job Requisition."></Property><Property Name="sectJobDetailsInfo" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="  EVERGREEN REQUISITION INFORMATION  Please complete the Requisition form below in order to initiate the hiring process.  All fields marked with an  *  are required.  The Requisition Status field will be changed automatically to &quot;Open&quot; once a requisition has successfully completed the job approval workflow.  If you need any other assistance please contact your Recruiting Consultant."></Property><Property Name="sectPosRequirements" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="  ADDITIONAL JOB INFORMATION"></Property><Property Name="sfstd_jobReqType" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="Job Requisition Type"></Property><Property Name="start" Type="Edm.DateTimeOffset" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sa