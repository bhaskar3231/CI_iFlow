<xsl:stylesheet version="3.0"    xmlns:xsl="http://www.w3.org/1999/XSL/Transform">    <xsl:output method="xml" indent="yes"/>    <xsl:mode on-no-match="shallow-copy"/>    <!-- Exclude CompoundEmployee if hiringNotCompleted is not false -->    <xsl:template match="CompoundEmployee[        not(            some $h in person/employment_information/hiringNotCompleted            satisfies lower-case(normalize-space($h)) = 'false'        )    ]"/>    </xsl:stylesheet>