" sap:deletable="false"><Documentation><Summary>BenefitEmployeeClaim</Summary><LongDescription>Contains information about claim transactions made by the employees for the various benefits in the company.</LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - Global Benefits</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="EmpPayCompNonRecurring" EntityType="SFOData.EmpPayCompNonRecurring" sap:label="Pay Component Non-Recurring" sap:creatable="false" sap:updatable="false" sap:upsertable="true" sap:deletable="false"><Documentation><Summary>EmpPayCompNonRecurring</Summary><LongDescription>Contains non recurring compensation information for an employee.</LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - Compensation Information</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="Background_Benefitselection" EntityType="SFOData.Background_Benefitselection" sap:label="Background_Benefitselection" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:deletable="true"><Documentation><Summary>Background*</Summary><LongDescription>Background objects are customizable to store general background information about an employee. Representative definitions include education and outside work experience</LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - Employee Profile</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="EmploymentConditionContent" EntityType="SFOData.EmploymentConditionContent" sap:label="Employment Condition Content" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:deletable="true"><Documentation><Summary>NOT IN PRODUCT!</Summary><LongDescription></LongDescription><sap:tagcollection><sap:tag>Suite (STE)</sap:tag><sap:tag>STE - Skills Management</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="Candidate" EntityType="SFOData.Candidate" sap:label="Candidate" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:deletable="false"><Documentation><Summary>Candidate</Summary><LongDescription>The candidate entity allows a user to query, insert and update the candidate profile. The candidate entity contains core candidate profile data consisting of system, standard and custom fields. The metadata will show the standard and custom fields configured in the active template. If a field (standard or custom) is not configured in the template, then it will not show up in the metadata and not be a part of oData query. The system fields will always show up.</LongDescription><sap:tagcollection><sap:tag>Recruiting (RCM)</sap:tag><sap:tag>RCM - Candidate</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="FormCustomizedWeightedRatingSection" EntityType="SFOData.FormCustomizedWeightedRatingSection" sap:label="FormCustomizedWeightedRatingSection" sap:creatable="false" sap:updatable="false" sap:upsertable="true" sap:deletable="false"><Documentation><Summary>FormCustomizedWeightedRatingSection</Summary><LongDescription>Contains Customized Weighted Rating Section details for a form</LongDescription><sap:tagcollection><sap:tag>Performance and Goals (PM/GM)</sap:tag><sap:tag>PM - Forms Management</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="BenefitProgramExceptionDetails" EntityType="SFOData.BenefitProgramExceptionDetails" sap:label="Benefit Program Exception Details" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:deletable="false"><Documentation><Summary>BenefitProgramExceptionDetails</Summary><LongDescription>Contains the relevant exception details for the benefit program.</LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - Global Benefits</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="CandidateBackground_OutsideWorkExperience" EntityType="SFOData.CandidateBackground_OutsideWorkExperience" sap:label="CandidateBackground_OutsideWorkExperience" sap:creatable="true" sap:updatable="false" sap:upsertable="true" sap:deletable="false"><Documentation><Summary>Candidate Background</Summary><LongDescription>These entities represent the background elements as defined in the candidate template. For example:CandidateBackground_Certificate, CandidateBackground_Education, etc</LongDescription><sap:tagcollection><sap:tag>Recruiting (RCM)</sap:tag><sap:tag>RCM - Candidate</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="JobApplicationOnboardingData" EntityType="SFOData.JobApplicationOnboardingData" sap:label="JobApplicationOnboardingData" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:deletable="false"><Documentation><Summary>JobApplicationOnboardingData</Summary><LongDescription>The JobApplicationOnboardingData represents the Onboarding portlet of a job application.</LongDescription><sap:tagcollection><sap:tag>Recruiting (RCM)</sap:tag><sap:tag>RCM - Job Application</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="FormSignatureSection" EntityType="SFOData.FormSignatureSection" sap:label="FormSignatureSection" sap:creatable="false" sap:updatable="false" sap:upsertable="true" sap:deletable="false"><Documentation><Summary>FormSignatureSection</Summary><LongDescription>Contains basic information of signature section associated with the form.</LongDescription><sap:tagcollection><sap:tag>Performance and Goals (PM/GM)</sap:tag><sap:tag>PM/GM - Continuous Performance Management</sap:tag><sap:tag>PM - Forms Management</sap:tag><sap:tag>Results List Not Supported</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="FOJobClassLocalITA" EntityType="SFOData.FOJobClassLocalITA" sap:label="Job Classification Italy " sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:deletable="false"><Documentation><Summary>FOJobClassLocalITA</Summary><LongDescription>This is a foundation object that contains country-specific job class for ITA.</LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - Foundation/Organization</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="PayPeriod" EntityType="SFOData.PayPeriod" sap:label="Pay Period" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:deletable="true"><Documentation><Summary>PayPeriod</Summary><LongDescription>This is a foundation object that describes one particular pay period. This is a time interval for which employees are paid.</LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - Foundation/Organization</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="FOPayRange" EntityType="SFOData.FOPayRange" sap:label="Pay Range" sap:creatable="false" sap:updatable="false" sap:upsertable="true" sap:deletable="false"><Documentation><Summary>FOPayRange</Summary><LongDescription>This is a foundation object that contains pay range related information.</LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - Foundation/Organization</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="BenefitInsuranceProvider" EntityType="SFOData.BenefitInsuranceProvider" sap:label="Insurance Provider" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:deletable="false"><Documentation><Summary>BenefitInsuranceProvider</Summary><LongDescription>Contains information related to the Service Provider of the particular Insurance Plan of the Insurance.</LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - Global Benefits</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="JobProfile" EntityType="SFOData.JobProfile" sap:label="Job Profile" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:deletable="true"><Documentation><Summary