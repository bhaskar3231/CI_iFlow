        <bpmn2:callActivity id="CallActivity_1168305" name="CM_SetBody">
            <bpmn2:extensionElements>
                <ifl:property>
                    <key>bodyType</key>
                    <value>expression</value>
                </ifl:property>
                <ifl:property>
                    <key>propertyTable</key>
                    <value/>
                </ifl:property>
                <ifl:property>
                    <key>headerTable</key>
                    <value/>
                </ifl:property>
                <ifl:property>
                    <key>wrapContent</key>
                    <value>&lt;p&gt;Hi,&lt;/p&gt;
		&lt;p&gt; &lt;/p&gt;
		&lt;p&gt;IFlow ${header.XOM_IflowName} has been successfully executed. Details are given below.&lt;/p&gt;
		&lt;!--Interface Details Table--&gt;
		&lt;p&gt;
			&lt;strong&gt;Interface details &lt;/strong&gt;
		&lt;/p&gt;
		&lt;p&gt; &lt;/p&gt;
		&lt;table style="border-collapse: collapse; width: 66.6667%; height: 108px;"
		       border="1" cellpadding="2" cellspacing="2"&gt;
			&lt;tbody&gt;
				&lt;tr&gt;
					&lt;td style="width: 50%; background-color: #c5c9d1;"&gt;&lt;strong&gt;      Iflow Name&lt;/strong&gt;&lt;/td&gt;
					&lt;td style="width: 50%;"&gt;
						&lt;left&gt; ${header.XOM_IflowName} &lt;/left&gt;
					&lt;/td&gt;
				&lt;/tr&gt;
		        &lt;tr&gt;
					&lt;td style="width: 50%; background-color: #c5c9d1;"&gt;&lt;strong&gt;        TimeStamp&lt;/strong&gt;&lt;/td&gt;
					&lt;td style="width: 50%;"&gt;
                                                 ${date:now:MM/dd/yyyy HH:mm:ss z}
					&lt;/td&gt;
				&lt;/tr&gt;
				&lt;tr&gt;
					&lt;td style="width: 30%; background-color: #c5c9d1;"&gt;&lt;strong&gt;        Link to the Iflow Monitor&lt;/strong&gt;&lt;/td&gt;
					&lt;td style="width: 70%;"&gt;
					    &lt;a href ='${header.XOM_LinktoMonitoringPage}'&gt;Link&lt;/a&gt;
					&lt;/td&gt;
				&lt;/tr&gt;
			&lt;/tbody&gt;
		&lt;/table&gt;
		&lt;p&gt; &lt;/p&gt;
		&lt;!--Detailed Report Table--&gt;
		&lt;p&gt;
			&lt;strong&gt;Detailed Report&lt;/strong&gt;
		&lt;/p&gt;
		&lt;p&gt; &lt;/p&gt;
		&lt;table style="border-collapse: collapse; width: 100%; height: 108px;"
		       border="1"&gt;
			&lt;tbody&gt;
				&lt;tr style="height: 17px;"&gt;
					&lt;td style="width: 10%; height: 17px; background-color: #4267B2;"&gt;
						&lt;span&gt;
							&lt;strong&gt;    Message ID&lt;/strong&gt;
						&lt;/span&gt;
					&lt;/td&gt;
					&lt;td style="width: 10%; height: 17px; background-color: #4267B2;"&gt;
						&lt;span&gt;
							&lt;strong&gt;    Correlation ID&lt;/strong&gt;
						&lt;/span&gt;
					&lt;/td&gt;
					&lt;td style="width: 30%; height: 17px; background-color: #4267B2;"&gt;
						&lt;span&gt;
							&lt;strong&gt;    Success Message&lt;/strong&gt;
						&lt;/span&gt;
					&lt;/td&gt;
				&lt;/tr&gt;
					&lt;tr style="height: 17px;"&gt;
						&lt;td style="width: 10%; height: 17px;"&gt;
							&lt;left&gt; ${header.XOM_MessageId} &lt;/left&gt;
						&lt;/td&gt;
						&lt;td style="width: 10%; height: 17px;"&gt;
							&lt;left&gt; ${header.XOM_CorrelationId} &lt;/left&gt;
						&lt;/td&gt;
						&lt;td style="width: 30%; height: 17px;"&gt;
							&lt;left&gt; ${property.Count} employees were successfully processed and sent to the AzureBlob location. &lt;/left&gt;
						&lt;/td&gt;						
					&lt;/tr&gt;
			&lt;/tbody&gt;
		&lt;/table&gt;
		&lt;p&gt; &lt;/p&gt;
		&lt;p&gt; &lt;/p&gt;
		&lt;p&gt; &lt;/p&gt;
		&lt;p&gt; &lt;/p&gt;
		&lt;p&gt; &lt;/p&gt;
		&lt;p&gt;***This is an automated email, please do not reply****&lt;/p&gt;
		&lt;p&gt; &lt;/p&gt;</value>
                </ifl:property>
                <ifl:property>
                    <key>componentVersion</key>
                    <value>1.6</value>
                </ifl:property>
                <ifl:property>
                    <key>activityType</key>
                    <value>Enricher</value>
                </ifl:property>
                <ifl:property>
                    <key>cmdVariantUri</key>
                    <value>ctype::FlowstepVariant/cname::Enricher/version::1.6.1</value>
                </ifl:property>
            </bpmn2:extensionElements>
            <bpmn2:incoming>SequenceFlow_1168303</bpmn2:incoming>
            <bpmn2:outgoing>SequenceFlow_1168306</bpmn2:outgoing>
        </bpmn2:callActivity>
